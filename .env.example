ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
ANTHROPIC_MODEL=claude-opus-4-6

# --- Voyage AI (Embeddings) ---
# Converts text to vectors for RAG retrieval
# Get key: https://dash.voyageai.com
VOYAGE_API_KEY=pa-your-key-here
VOYAGE_MODEL=voyage-3-lite

# --- Neon (PostgreSQL + pgvector) ---
# Database for vectors, conversation logs, eval data
# Get URL: https://console.neon.tech → Project → Connection Details
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Use Test API key:  sk_test_**
# Get key: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your-key-here

# --- Agent Configuration ---
# These control agent behavior (we'll use them in later sections)
AGENT_MAX_TOOL_CALLS=10
AGENT_CONFIDENCE_THRESHOLD=0.7
AGENT_MAX_REFUND_AMOUNT=200